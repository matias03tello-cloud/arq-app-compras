# Variables públicas: nunca poner contraseñas, private keys ni tokens aquí.
EXPO_PUBLIC_PRIVACY_RESPONSABLE=
EXPO_PUBLIC_PRIVACY_EMAIL=
# Web opcional: registrar la clave y los dominios en reCAPTCHA Enterprise/App Check.
EXPO_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Dejar false para pruebas. true bloquea el arranque hasta implementar atestación nativa.
EXPO_PUBLIC_REQUIRE_NATIVE_APP_CHECK=false
