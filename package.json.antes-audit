{
  "name": "mi-app-local",
  "main": "expo-router/entry",
  "version": "5.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/security.test.mjs tests/fechas.test.mjs tests/ingreso.test.mjs tests/camara.test.mjs tests/experiencia.test.mjs tests/compras.test.mjs tests/apertura.test.mjs tests/avisos.test.mjs tests/recetas.test.mjs tests/integracion-etapas.test.mjs functions/test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-frescapp-security \"node --test tests/firestore.rules.test.mjs\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-frescapp-security \"node --test tests/privacy.integration.test.mjs\"",
    "test:flujos": "firebase emulators:exec --only firestore --project demo-frescapp-security \"node --test --test-concurrency=1 tests/compra-historial.integration.test.mjs tests/recetas-compras.integration.test.mjs tests/hogares.integration.test.cjs\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "expo": "^57.0.20",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-tools": "^14.17.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
