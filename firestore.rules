rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && !exists(/databases/$(database)/documents/eliminaciones/$(uid));
    }
    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    // Dataset propio: mantener junto con security/identidadProducto.ts.
    function generic(d) {
      let foods = {
        'sin:manzana': ['Manzana', 'Frutas'],
        'sin:platano': ['Plátano', 'Frutas'],
        'sin:naranja': ['Naranja', 'Frutas'],
        'sin:mandarina': ['Mandarina', 'Frutas'],
        'sin:limon': ['Limón', 'Frutas'],
        'sin:pera': ['Pera', 'Frutas'],
        'sin:durazno': ['Durazno', 'Frutas'],
        'sin:ciruela': ['Ciruela', 'Frutas'],
        'sin:frutilla': ['Frutilla', 'Frutas'],
        'sin:uva': ['Uva', 'Frutas'],
        'sin:kiwi': ['Kiwi', 'Frutas'],
        'sin:sandia': ['Sandía', 'Frutas'],
        'sin:melon': ['Melón', 'Frutas'],
        'sin:pina': ['Piña', 'Frutas'],
        'sin:arandano': ['Arándano', 'Frutas'],
        'sin:palta': ['Palta', 'Frutas'],
        'sin:tomate': ['Tomate', 'Verduras'],
        'sin:papa': ['Papa', 'Verduras'],
        'sin:cebolla': ['Cebolla', 'Verduras'],
        'sin:zanahoria': ['Zanahoria', 'Verduras'],
        'sin:lechuga': ['Lechuga', 'Verduras'],
        'sin:pepino': ['Pepino', 'Verduras'],
        'sin:zapallo': ['Zapallo', 'Verduras'],
        'sin:zapallo-italiano': ['Zapallo italiano', 'Verduras'],
        'sin:brocoli': ['Brócoli', 'Verduras'],
        'sin:coliflor': ['Coliflor', 'Verduras'],
        'sin:espinaca': ['Espinaca', 'Verduras'],
        'sin:acelga': ['Acelga', 'Verduras'],
        'sin:pimenton': ['Pimentón', 'Verduras'],
        'sin:ajo': ['Ajo', 'Verduras'],
        'sin:apio': ['Apio', 'Verduras'],
        'sin:repollo': ['Repollo', 'Verduras']
      };
      return d.codigoBarras in foods && d.nombre == foods[d.codigoBarras][0]
        && d.categoria == foods[d.codigoBarras][1] && d.marca == 'Sin marca'
        && d.formato == 'A granel' && d.unidad in ['unidad','kg','g'];
    }
    function sameIdentity(a, b) {
      return a.codigoBarras == b.codigoBarras && a.nombre == b.nombre && a.marca == b.marca
        && a.categoria == b.categoria && a.formato == b.formato && a.unidad == b.unidad;
    }
    function barcodeIdentity(d, uid) {
      let common = /databases/$(database)/documents/productos/$(d.codigoBarras);
      let personal = /databases/$(database)/documents/usuarios/$(uid)/productosPrivados/$(d.codigoBarras);
      return exists(common)
        ? get(common).data.activo == true && sameIdentity(d, get(common).data)
        : existsAfter(personal) && getAfter(personal).data.activo == true && sameIdentity(d, getAfter(personal).data);
    }
    function validIdentity(d, uid) {
      return d.codigoBarras.matches('^sin:.*$') ? generic(d) : barcodeIdentity(d, uid);
    }
    function product(d) {
      return d.codigoBarras is string && (d.codigoBarras.matches('^[0-9]{8,14}$') || generic(d))
        && text(d.nombre, 1, 120) && text(d.marca, 1, 80)
        && d.categoria in ['Lacteos','Carnes','Frutas','Verduras','Despensa','Bebidas','Congelados','Snacks','Otros']
        && text(d.formato, 0, 80) && text(d.unidad, 1, 30);
    }
    function openingDate(fecha) {
      let partes = fecha.split('-');
      let y = int(partes[0]); let m = int(partes[1]); let d = int(partes[2]);
      let leap = y % 400 == 0 || (y % 4 == 0 && y % 100 != 0);
      let days = m in [1,3,5,7,8,10,12] ? 31 : (m == 2 ? (leap ? 29 : 28) : 30);
      return y >= 1900 && m >= 1 && m <= 12 && d >= 1 && d <= days
        && y*10000+m*100+d <= request.time.year()*10000+request.time.month()*100+request.time.day();
    }
    function validOpening(d) {
      let fecha = d.get('abiertoEn', '');
      return fecha == '' || (fecha is string && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && openingDate(fecha));
    }
    function inventory(d) {
      return d.keys().hasAll(['codigoBarras','nombre','marca','categoria','formato','unidad','cantidad','vencimiento','fechaRegistro','creadoEn'])
        && d.keys().hasOnly(['codigoBarras','nombre','marca','categoria','formato','unidad','cantidad','vencimiento','fechaRegistro','creadoEn','ubicacion','abiertoEn'])
        && validOpening(d) && product(d) && d.cantidad is number && d.cantidad > 0 && d.cantidad <= 999
        && ((d.cantidad is int) || (generic(d) && d.unidad in ['kg','g']))
        && d.get('ubicacion', 'Despensa') in ['Despensa','Refrigerador','Congelador']
        && d.vencimiento is string
        && (d.vencimiento == 'Sin fecha' || d.vencimiento.matches('^([0-9]{2}/)?[0-9]{2}/[0-9]{4}$'))
        && text(d.fechaRegistro, 1, 30) && d.creadoEn is timestamp;
    }
        function validShopping(d) {
          return d.keys().hasAll(['nombre', 'cantidad', 'unidad', 'comprado', 'creadoEn', 'actualizadoEn'])
            && d.keys().hasOnly(['nombre', 'cantidad', 'unidad', 'comprado', 'creadoEn', 'actualizadoEn'])
            && text(d.nombre, 2, 120)
            && !d.nombre.matches('.*[<>\\n\\r].*')
            && d.cantidad is number && d.cantidad > 0 && d.cantidad <= 999
            && d.unidad in ['unidad', 'kg', 'g', 'L']
            && (d.unidad != 'unidad' || d.cantidad % 1 == 0)
            && d.comprado is bool && d.creadoEn is timestamp && d.actualizadoEn == request.time;
        }

    function validMovement(d, path, witness, eventId) {
      let original = get(path).data;
      let resto = original.cantidad - d.cantidad;
      return d.keys().hasAll(['productoId','codigoBarras','nombre','marca','formato','unidad','vencimiento','tipo','motivo','cantidad','restante','creadoEn'])
        && d.keys().hasOnly(['productoId','codigoBarras','nombre','marca','formato','unidad','vencimiento','tipo','motivo','cantidad','restante','creadoEn'])
        && d.codigoBarras == original.codigoBarras && d.nombre == original.nombre && d.marca == original.marca
        && d.formato == original.formato && d.unidad == original.unidad && d.vencimiento == original.vencimiento
        && d.tipo in ['consumo','desperdicio'] && (d.tipo == 'consumo' ? d.motivo == 'Consumido' : d.motivo in ['Vencimiento','Deterioro','Otro'])
        && d.cantidad is number && d.cantidad > 0 && d.cantidad <= original.cantidad
        && (d.cantidad is int || (original.codigoBarras.matches('^sin:.*$') && original.unidad in ['kg','g']))
        && d.restante is number && d.restante >= 0 && math.abs(d.restante - resto) < 0.0000001
        && d.creadoEn == request.time && getAfter(witness).data.eventoId == eventId
        && (d.restante == 0 ? !existsAfter(path) : existsAfter(path) && math.abs(getAfter(path).data.cantidad - d.restante) < 0.0000001);
    }
    function catalog(d) {
      return d.keys().hasAll(['codigoBarras','nombre','marca','categoria','formato','unidad','activo'])
        && d.keys().hasOnly(['codigoBarras','nombre','marca','categoria','formato','unidad','activo'])
        && product(d) && d.activo is bool;
    }
    match /usuarios/{uid} {
      allow get: if owner(uid);
      // Perfil canónico en Authentication. El documento antiguo solo se lee o
      // borra desde el backend; el cliente no puede otorgarse roles ni privilegios.
      allow list, create, update, delete: if false;
      match /comprasRegistradas/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.keys().hasAll(['codigoBarras','creadoEn'])
          && request.resource.data.keys().hasOnly(['codigoBarras','creadoEn'])
          && request.resource.data.creadoEn == request.time
          && !exists(/databases/$(database)/documents/usuarios/$(uid)/inventario/$(id))
          && getAfter(/databases/$(database)/documents/usuarios/$(uid)/inventario/$(id)).data.codigoBarras == request.resource.data.codigoBarras;
        allow update, delete: if false;
      }
      match /salidasConfirmadas/{producto} {
        function paired(d) {
          let event = /databases/$(database)/documents/usuarios/$(uid)/historial/$(d.eventoId);
          return d.keys().hasOnly(['eventoId']) && text(d.eventoId,1,200) && !exists(event)
            && getAfter(event).data.productoId == producto && getAfter(event).data.creadoEn == request.time;
        }
        allow read: if owner(uid);
        allow create, update: if owner(uid) && paired(request.resource.data);
        allow delete: if false;
      }
      match /historial/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validMovement(request.resource.data,
          /databases/$(database)/documents/usuarios/$(uid)/inventario/$(request.resource.data.productoId),
          /databases/$(database)/documents/usuarios/$(uid)/salidasConfirmadas/$(request.resource.data.productoId), id);
        allow update, delete: if false;
      }
      match /hogares/{id} { allow read: if owner(uid); allow write: if false; }
      match /inventario/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && inventory(request.resource.data)
          && request.resource.data.creadoEn == request.time
          && validIdentity(request.resource.data, uid);
        allow update: if owner(uid) && inventory(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidad','vencimiento','ubicacion','abiertoEn']);
      }
      match /productosPrivados/{codigo} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && catalog(request.resource.data)
          && request.resource.data.codigoBarras == codigo
          && codigo.matches('^[0-9]{8,14}$')
          && !exists(/databases/$(database)/documents/productos/$(codigo))
          && text(request.resource.data.nombre, 2, 120)
          && !request.resource.data.nombre.matches('.*[<>@].*')
          && !request.resource.data.nombre.matches('.*[hH][tT][tT][pP][sS]?://.*')
          && !request.resource.data.nombre.matches('.*[wW][wW][wW]\\..*');
      }
      match /listaCompras/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && validShopping(request.resource.data)
          && request.resource.data.creadoEn == request.time && request.resource.data.comprado == false;
        allow update: if owner(uid) && validShopping(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comprado', 'actualizadoEn']);
      }
      match /reportesCatalogo/{codigo} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && exists(/databases/$(database)/documents/productos/$(codigo))
          && request.resource.data.keys().hasAll(['codigoBarras','detalle','creadoEn'])
          && request.resource.data.keys().hasOnly(['codigoBarras','detalle','creadoEn'])
          && request.resource.data.codigoBarras == codigo
          && text(request.resource.data.detalle, 5, 300)
          && request.resource.data.creadoEn == request.time;
      }
      match /privacidad/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && id == 'aviso'
          && request.resource.data.keys().hasOnly(['version','leidoEn'])
          && request.resource.data.keys().hasAll(['version','leidoEn'])
          && request.resource.data.version == '2026-09-12-borrador'
          && request.resource.data.leidoEn == request.time;
        allow delete: if false;
      }
    }
    function householdMember(id) {
      let h = get(/databases/$(database)/documents/hogares/$(id)).data;
      return request.auth != null && owner(request.auth.uid) && h.estado == 'activo'
        && !exists(/databases/$(database)/documents/eliminaciones/$(h.propietario)) && request.auth.uid in h.miembros;
    }
    match /hogares/{id} {
      allow get: if householdMember(id);
      allow list, write: if false;
      match /inventario/{item} {
        allow read, delete: if householdMember(id);
        allow create: if householdMember(id) && inventory(request.resource.data)
          && request.resource.data.creadoEn == request.time && validIdentity(request.resource.data, request.auth.uid);
        allow update: if householdMember(id) && inventory(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidad','vencimiento','ubicacion','abiertoEn']);
      }
      match /salidasConfirmadas/{producto} {
        function paired(d) {
          let event = /databases/$(database)/documents/hogares/$(id)/historial/$(d.eventoId);
          return d.keys().hasOnly(['eventoId']) && text(d.eventoId,1,200) && !exists(event)
            && getAfter(event).data.productoId == producto && getAfter(event).data.creadoEn == request.time;
        }
        allow read: if householdMember(id);
        allow create, update: if householdMember(id) && paired(request.resource.data);
        allow delete: if false;
      }
      match /historial/{evento} {
        allow read: if householdMember(id);
        allow create: if householdMember(id) && validMovement(request.resource.data,
          /databases/$(database)/documents/hogares/$(id)/inventario/$(request.resource.data.productoId),
          /databases/$(database)/documents/hogares/$(id)/salidasConfirmadas/$(request.resource.data.productoId), evento);
        allow update, delete: if false;
      }
      match /listaCompras/{item} {
        allow read, delete: if householdMember(id);
        allow create: if householdMember(id) && validShopping(request.resource.data)
          && request.resource.data.creadoEn == request.time && request.resource.data.comprado == false;
        allow update: if householdMember(id) && validShopping(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comprado','actualizadoEn']);
      }
    }
    match /productos/{codigo} {
      allow read: if request.auth != null && owner(request.auth.uid);
      // El catálogo común se administra con herramientas de servidor/Console.
      allow write: if false;
    }
    match /inventario/{id} {
      // Compatibilidad: únicamente el dueño original puede leer/borrar.
      // No se permite adoptar usuario_demo ni modificar usuarioId.
      allow read, delete: if request.auth != null && owner(request.auth.uid)
        && resource.data.usuarioId == request.auth.uid;
      allow create, update: if false;
    }
    match /eliminaciones/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

