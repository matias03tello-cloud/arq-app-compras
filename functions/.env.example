# Parámetro local del runtime de Firebase Functions; no es una credencial.
# Copiar a functions/.env para el emulador; ese archivo local se excluye de Git.
# En producción, Functions usa la identidad de ejecución de Google Cloud (ADC).
# No agregar claves privadas ni archivos JSON de cuentas de servicio.
# Mantener false hasta integrar y probar App Check en todas las plataformas.
ENFORCE_APP_CHECK=false
